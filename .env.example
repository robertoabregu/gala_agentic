# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG
MIN_CHUNK_SIZE=500
MAX_CHUNK_SIZE=800
RAG_SCORE_THRESHOLD=0.5

# Langfuse opcional
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_OBSERVABILITY_ENABLED=true
LANGFUSE_NODE_OBSERVABILITY_ENABLED=true
LANGFUSE_NODE_SCORE_ENABLED=true
LANGFUSE_QUALITY_EVAL_ENABLED=true
LANGFUSE_CATEGORICAL_SCORES_ENABLED=true
LANGFUSE_SESSION_METRICS_ENABLED=true
LANGFUSE_SESSION_CATEGORICAL_ENABLED=true
LLM_JUDGE_ENABLED=false
OPENAI_MODEL_JUDGE=
LLM_JUDGE_MAX_INPUT_CHARS=1000
LLM_JUDGE_MAX_CONTEXT_CHARS=2000
APP_ENV=dev
APP_VERSION=unknown
GALA_GRAPH_VERSION=gala_graph_v1
EVALUATION_ENDPOINT_ENABLED=true
EVALUATION_ENDPOINT_TOKEN=
EVALUATION_BACKEND_URL=http://localhost:5000
LANGFUSE_DATASET_NAME=
LANGFUSE_EXPERIMENT_NAME=
LANGFUSE_EXPERIMENT_DESCRIPTION=
EVALUATION_REQUEST_TIMEOUT_SECONDS=45
LANGFUSE_EXPERIMENT_MAX_CONCURRENCY=4

# Scripts de enriquecimiento opcionales
OPENAI_MODEL_ENRICH=gpt-4o-mini
ENRICH_INPUT_PATH=data/documents.json
ENRICH_OUTPUT_PATH=data/documents_enriched.json
OPENAI_MODEL_CHITCHAT=gpt-4o-mini

# Benefits
BENEFITS_API_BASE_URL=https://loyalty.bff.bancogalicia.com.ar/api/portal/personalizacion/v1
BENEFITS_LOCALES_PAGE_SIZE=1500
BENEFITS_DISTANCE_FROM_KM=0
BENEFITS_DISTANCE_TO_KM=10
BENEFITS_MAX_RESULTS=5
BENEFITS_DETAIL_MAX_CANDIDATES=5
BENEFITS_DETAIL_EXPANSION_BATCH=3
BENEFITS_MIN_PROMO_RESULTS=3
BENEFITS_REQUEST_TIMEOUT=8
BENEFITS_NEARBY_CACHE_TTL_SECONDS=180
BENEFITS_DETAIL_CACHE_TTL_SECONDS=600
BENEFITS_LOCATION_CACHE_ROUND_DECIMALS=3

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ACK_MESSAGE=Buscando las mejores promociones para vos, te escribo enseguida... 🔎
TWILIO_ACK_MEDIA_URL=
TWILIO_STATUS_CALLBACK_URL=
WHATSAPP_ASYNC_MAX_WORKERS=4
WHATSAPP_INBOUND_DEDUPE_TTL_SECONDS=1800
